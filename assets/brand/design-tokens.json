{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "name": "Creaturely",
    "tagline": "Know their normal.",
    "version": "1.0.0"
  },
  "color": {
    "primitive": {
      "teal": {
        "700": "#075D59",
        "600": "#096B66",
        "500": "#087E78",
        "200": "#77D6CE",
        "100": "#CFEDEA"
      },
      "coral": {
        "500": "#F26B5B",
        "100": "#FFF1ED"
      },
      "neutral": {
        "950": "#102523",
        "900": "#19302F",
        "600": "#5D706F",
        "300": "#D7E3E1",
        "100": "#F7FBFA",
        "0": "#FFFFFF"
      },
      "semantic": {
        "success": "#237A4B",
        "warning": "#8A5A00",
        "error": "#B64145",
        "info": "#2E6FA3"
      }
    },
    "light": {
      "primary": "#087E78",
      "onPrimary": "#FFFFFF",
      "primaryContainer": "#CFEDEA",
      "onPrimaryContainer": "#19302F",
      "accent": "#F26B5B",
      "onAccent": "#19302F",
      "accentContainer": "#FFF1ED",
      "background": "#F7FBFA",
      "surface": "#FFFFFF",
      "text": "#19302F",
      "textMuted": "#5D706F",
      "border": "#D7E3E1"
    },
    "dark": {
      "primary": "#77D6CE",
      "onPrimary": "#0B2D2A",
      "primaryContainer": "#096B66",
      "onPrimaryContainer": "#EAF4F2",
      "accent": "#FF9B8B",
      "onAccent": "#3D1210",
      "background": "#102523",
      "surface": "#17312F",
      "text": "#EAF4F2",
      "textMuted": "#B8CAC7",
      "border": "#607A76"
    }
  },
  "typography": {
    "displayFamily": "ui-rounded, SF Pro Rounded, Arial Rounded MT Bold, sans-serif",
    "uiFamily": "system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "shape": {
    "radiusSmall": 8,
    "radiusMedium": 14,
    "radiusLarge": 24,
    "radiusPill": 999
  },
  "logo": {
    "minimumDigitalWidth": {
      "horizontal": 120,
      "mark": 24
    },
    "clearSpace": "One central paw-pad height on every side"
  }
}
