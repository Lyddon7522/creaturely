APP_IDENTIFIER = "com.vector42.creaturely"
REPOSITORY_ROOT = File.expand_path("..", __dir__)

ENV["FASTLANE_SKIP_UPDATE_CHECK"] ||= "1"
opt_out_usage

def required_environment_variable(name)
  value = ENV[name]&.strip
  UI.user_error!("#{name} must be configured before this lane can run.") if value.nil? || value.empty?

  value
end

def existing_file_from_environment(name, extension)
  path = File.expand_path(required_environment_variable(name), REPOSITORY_ROOT)
  UI.user_error!("#{name} does not point to a file: #{path}") unless File.file?(path)
  UI.user_error!("#{name} must point to a #{extension} file.") unless File.extname(path) == extension

  path
end

platform :android do
  desc "Upload an existing signed AAB to Google Play Internal testing"
  lane :beta do
    aab_path = existing_file_from_environment("CREATURELY_ANDROID_AAB_PATH", ".aab")
    credentials_path = existing_file_from_environment(
      "GOOGLE_PLAY_CREDENTIALS_PATH",
      ".json",
    )
    artifact_directory = File.dirname(aab_path)
    mapping_paths = Dir[
      File.join(artifact_directory, "*-android-mapping.txt"),
      File.join(artifact_directory, "*-android-native-symbols.zip"),
    ].select { |path| File.file?(path) }

    options = {
      package_name: APP_IDENTIFIER,
      aab: aab_path,
      json_key: credentials_path,
      track: "internal",
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    }
    options[:mapping_paths] = mapping_paths unless mapping_paths.empty?

    upload_to_play_store(**options)
  end
end

platform :ios do
  desc "Upload an existing signed IPA to TestFlight internal testing"
  lane :beta do
    ipa_path = existing_file_from_environment("CREATURELY_IOS_IPA_PATH", ".ipa")
    testflight_group = ENV["TESTFLIGHT_INTERNAL_GROUP"]&.strip
    api_key = app_store_connect_api_key(
      key_id: required_environment_variable("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: required_environment_variable("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: required_environment_variable("APP_STORE_CONNECT_PRIVATE_KEY_BASE64"),
      is_key_content_base64: true,
    )

    options = {
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: ipa_path,
      distribute_external: false,
      notify_external_testers: false,
      uses_non_exempt_encryption: false,
    }

    if testflight_group.nil? || testflight_group.empty?
      UI.important(
        "TESTFLIGHT_INTERNAL_GROUP is not set. The IPA will be uploaded but not assigned to testers.",
      )
      options[:skip_submission] = true
      options[:skip_waiting_for_build_processing] = true
    else
      app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
      UI.user_error!("Creaturely does not exist in App Store Connect.") if app.nil?
      internal_group = app.get_beta_groups.find do |group|
        group.name == testflight_group && group.is_internal_group
      end
      if internal_group.nil?
        UI.user_error!(
          "No internal TestFlight group named '#{testflight_group}' exists for Creaturely.",
        )
      end

      options[:groups] = [testflight_group]
      options[:submit_beta_review] = false
      options[:skip_waiting_for_build_processing] = false
      options[:wait_processing_timeout_duration] = 1_800
    end

    upload_to_testflight(**options)
  end
end
