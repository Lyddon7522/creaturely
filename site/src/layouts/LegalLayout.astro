---
import BaseLayout from './BaseLayout.astro';
import './LegalLayout.css';

interface Props {
  title: string;
  description: string;
  heading: string;
  intro: string;
  effectiveDate: string;
}

const { title, description, heading, intro, effectiveDate } = Astro.props;
---

<BaseLayout title={title} description={description} bodyClass="legal-body">
  <main id="main-content" class="legal-page">
    <header class="legal-hero shell">
      <h1>{heading}</h1>
      <p>{intro}</p>
      <time>{effectiveDate}</time>
    </header>

    <div class="legal-layout shell">
      <aside class="legal-contents" aria-label="On this page">
        <p>On this page</p>
        <slot name="contents" />
      </aside>
      <article class="legal-copy">
        <slot />
      </article>
    </div>
  </main>
</BaseLayout>
